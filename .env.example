# =============================================================
#  SmartAqua — Environment variables template
#  คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
#    cp .env.example .env
#
#  ⚠ ห้าม commit ไฟล์ .env ขึ้น Git — มี .gitignore จัดการให้แล้ว
# =============================================================

# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_CHANGE_ME
MYSQL_DATABASE=smartaqua
MYSQL_USER=user
MYSQL_PASSWORD=password_CHANGE_ME

# ── PHP → DB connection (db.php ใช้ชื่อนี้) ───────────────────
DB_HOST=db
DB_PORT=3306
DB_NAME=smartaqua
DB_USER=user
DB_PASSWORD=password_CHANGE_ME

# ── Cron token (cron/purge_old_logs.php via browser) ─────────
# ตั้งเป็น random string ยาวๆ เช่น openssl rand -hex 32
CRON_TOKEN=change-me-to-a-long-random-string
